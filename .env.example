# Names only. Copy to .env (git-ignored) and fill in locally. Never commit values.

# NASA Earthdata Login, used only by the offline pipeline (or keep it in ~/.netrc)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# API (server-side)
DATA_DIR=
CORS_ORIGINS=

# Web build (VITE_* values are public: never put a secret here)
VITE_API_URL=
VITE_DATA_URL=
VITE_REPO_URL=
